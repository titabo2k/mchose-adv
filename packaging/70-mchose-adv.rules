# MCHOSE Ace 68 -III is 3837:3003.
#
# This grants the active local user read/write access to the hidraw nodes of
# that keyboard. That covers two separate things:
#
#   1. mchose-adv itself, which needs READ access to USB interface 2 -- where
#      the keyboard sends keys resolved by its advanced-key features
#      (SOCD / RS / DKS / MT / TGL). Linux does not translate that report.
#
#   2. The vendor's web driver (M-HUB in Chrome/Edge/Opera), which needs
#      read *and write* access to configure the keyboard at all. Without a rule
#      like this the browser can only open the device read-only, settings
#      silently fail to save, and a half-written profile can leave keys dead.
#      You do not need a separate hand-written rule for that.
#
# MODE/GROUP are set explicitly in addition to uaccess so this also works for
# a systemd user service, which may not see the active-session ACL that
# TAG+="uaccess" relies on.
#
# Matching is deliberately limited to this one product id, and to hidraw only
# (no raw SUBSYSTEM=="usb" access, which neither the daemon nor WebHID needs).
# For another MCHOSE model, copy the line and change idProduct; widening it to
# the whole vendor id (drop the idProduct match) is possible but grants access
# to every MCHOSE device.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3837", ATTRS{idProduct}=="3003", MODE="0660", GROUP="input", TAG+="uaccess"

# Needed to create the virtual keyboard that re-emits the advanced keys.
# Most desktops already do this (80-uinput.rules); repeated here so the package
# is self-contained and works on minimal systems too.
KERNEL=="uinput", SUBSYSTEM=="misc", MODE="0660", GROUP="input", TAG+="uaccess", OPTIONS+="static_node=uinput"
